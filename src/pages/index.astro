---
// Homepage (new design, Oct 2026).
// All content comes from src/content/site.json (single source of truth).
import { siteConfig } from "../config";
import "../styles/v2.css";

const c = siteConfig as any;

// ---- Work: one list, de-duplicated, clean categories ----
const seen = new Set<string>();
const works = (c.featuredWork ?? [])
  .filter((w: any) => (seen.has(w.title) ? false : (seen.add(w.title), true)))
  .map((w: any) => ({
    ...w,
    cats: String(w.category ?? "").split(",").map((s: string) => s.trim()).filter(Boolean),
  }));

const CAT_LABELS: Record<string, string> = {
  powerbi: "Power BI", fabric: "Fabric", kql: "KQL", python: "Python",
  dataanalysis: "Data Analysis", dataviz: "Data Viz", html: "HTML / Custom visuals",
};
const catCount: Record<string, number> = {};
works.forEach((w: any) => w.cats.forEach((k: string) => (catCount[k] = (catCount[k] ?? 0) + 1)));
const filters = Object.keys(CAT_LABELS).filter((k) => catCount[k]);

// ---- What I do: the 7 services, in their own order ----
const stages = (c.services ?? []).map((sv: any) => ({
  key: String(sv.title ?? "").replace(/^\d+\.\s*/, ""),
  text: sv.short ?? "",
  chips: sv.chips ?? [],
  services: sv.description ? [{ description: sv.description }] : [],
}));

// ---- Certifications ----
const edu = c.education ?? [];
const topCerts = edu.filter((e: any) => /DP-600|PL-300/.test(e.degree));
const olderEdu = edu.filter((e: any) => !/DP-600|PL-300/.test(e.degree));
const certCode = (d: string) => (d.match(/(DP-600|PL-300)/) ?? [""])[0];

const agentPrompt = `Fetch ${c.agentUrl} and read it as context about ${c.name} — a ${c.shortTitle}.\n\nFirst, ask me about my data challenge or what I'm looking for, then wait for my answer. Then assess whether ${c.name} would be a good fit.`;

const nav = [
  ["about", "About"], ["stack", "What I do"], ["experience", "Experience"],
  ["work", "Work"], ["certifications", "Certifications"], ["agent", "Tell your agent"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={c.description} />
    <title>{c.name} — {c.shortTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = "dark"; // default: night mode
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <div class="spotlight" aria-hidden="true"></div>

    <div class="topbar">
      <span class="who"><img src="/logo-mark.svg" alt="" width="24" height="24" />{c.name}</span>
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle day / night mode">
        <span class="knob">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </span>
      </button>
    </div>

    <div class="wrap">
      <!-- ============ LEFT ============ -->
      <header class="side">
        <div>
          <a class="brand" href="#about"><img src="/logo-mark.svg" alt="" width="40" height="40" /><span class="mono">Geronimo Analytics</span></a>
          <h1 class="name">{c.name}</h1>
          <p class="role">{c.shortTitle}</p>
          <p class="tagline">From raw source to the decision on the screen: platform, model, custom visual and AI agent. The whole stack, end to end.</p>
          {c.availability?.show !== false && c.availability && (
            <div class={`status ${c.availability.employed !== false ? "is-employed" : "is-available"}`}>
              <span class="status-dot" aria-hidden="true"></span>
              <span>
                <b>{c.availability.employed !== false ? c.availability.employedText : c.availability.availableText}</b>
                {c.availability.subtext && <span class="status-sub">{c.availability.subtext}</span>}
              </span>
            </div>
          )}
          <div class="certs-mini mono">
            {topCerts.map((e: any) => <span class="cert-chip"><b>{certCode(e.degree)}</b> certified</span>)}
          </div>
          <nav class="nav" aria-label="Sections">
            {nav.map(([id, label]) => <a href={`#${id}`} data-nav={id}>{label}</a>)}
          </nav>
        </div>
        <div class="side-foot">
          <div class="social">
            {c.social?.github && (
              <a href={c.social.github} target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
              </a>
            )}
            {c.social?.linkedin && (
              <a href={c.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.6V9h3.5v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
              </a>
            )}
            {c.social?.email && (
              <a href={`mailto:${c.social.email}`} aria-label="Email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              </a>
            )}
          </div>
          <button class="theme-toggle" data-theme-toggle aria-label="Toggle day / night mode">
            <span class="knob">
              <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              <svg class="moon" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </span>
          </button>
        </div>
      </header>

      <!-- ============ RIGHT ============ -->
      <main class="content">
        <section id="about" class="about">
          <div class="sec-head hide-lg"><span class="num mono">01</span><h2>About</h2></div>
          <p class="lead">Most data people own one layer of the stack. I build the whole chain, from the Fabric pipeline to the pixel your board looks at, and lately the AI agent that answers their follow-up question.</p>
          {(c.aboutMe ?? []).map((p: string) => <p>{p}</p>)}
        </section>

        <section id="stack">
          <div class="sec-head"><span class="num mono">02</span><h2>What I do</h2></div>
          <div class="pipeline">
            {stages.map((s, i) => (
              <div class="stage">
                <div class="dot mono">{String(i + 1).padStart(2, "0")}</div>
                <div>
                  <h3>{s.key}</h3>
                  <p>{s.text}</p>
                  <div class="chips">{s.chips.map((ch) => <span class="chip">{ch}</span>)}</div>
                  {s.services.length > 0 && (
                    <details class="more">
                      <summary>How I help</summary>
                      {s.services.map((sv: any) => (
                        <div class="svc">{sv.description}</div>
                      ))}
                    </details>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="experience">
          <div class="sec-head"><span class="num mono">03</span><h2>Experience</h2></div>
          <div class="jobs">
            {(c.experience ?? []).map((j: any) => (
              <article class="job">
                <div class="when mono">{j.dateRange}</div>
                <div>
                  <h3>{j.title} <span>· {j.company}</span></h3>
                  <ul>{(j.bullets ?? []).map((b: string) => <li>{b}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
          <div class="links-row" style="margin-top:20px;padding-left:20px">
            {c.social?.linkedin && <a class="btn ghost" href={c.social.linkedin} target="_blank" rel="noopener">Full profile on LinkedIn →</a>}
          </div>
        </section>

        <section id="work">
          <div class="sec-head"><span class="num mono">04</span><h2>Work</h2></div>
          <div class="filters" role="group" aria-label="Filter projects">
            <button class="pill active" data-filter="all">All<span class="count">{works.length}</span></button>
            {filters.map((k) => <button class="pill" data-filter={k}>{CAT_LABELS[k]}<span class="count">{catCount[k]}</span></button>)}
          </div>
          <div class="grid">
            {works.map((w: any, i: number) => (
              <button class="card" data-i={i} data-cats={w.cats.join(",")}>
                <div class="thumb"><img src={w.thumbnail} alt="" loading="lazy" /></div>
                <div class="body">
                  <h3>{w.title}</h3>
                  <p>{w.summary}</p>
                  {w.video && <span class="play mono">▶ VIDEO</span>}
                  <div class="chips">{(w.tags ?? []).map((t: string) => <span class="chip">{t}</span>)}</div>
                </div>
              </button>
            ))}
          </div>
        </section>

        <section id="certifications">
          <div class="sec-head"><span class="num mono">05</span><h2>Certifications</h2></div>
          <div class="cert-grid">
            {topCerts.map((e: any) => (
              <div class="cert">
                <div class="code mono">{certCode(e.degree)}</div>
                <h3>{e.degree.replace(/\s*(DP-600|PL-300)\s*/, " ").trim()}</h3>
                <div class="yr">{e.school} · {e.dateRange}</div>
              </div>
            ))}
          </div>
          <ul class="older">
            {olderEdu.map((e: any) => <li><span>{e.degree}</span><span class="mono">{e.dateRange}</span></li>)}
          </ul>
        </section>

        <section id="agent">
          <div class="sec-head"><span class="num mono">06</span><h2>Tell your agent</h2></div>
          <p>Not sure if I'm a fit? Paste this into your AI assistant. It reads my profile and tells you whether I can help.</p>
          <div class="prompt mono" id="agent-prompt">{agentPrompt}</div>
          <div class="btn-row">
            <button class="btn" id="copy-prompt">Copy prompt</button>
            {c.social?.email && <a class="btn ghost" href={`mailto:${c.social.email}`}>Or just email me</a>}
          </div>
        </section>

        <footer class="foot">
          <p>Also on this site: <a href="/visuals/">PBI Viz Chckr</a> · <a href="/customvisuals/">PBI Custom Viz Chckr</a> · <a href="/agents/">Agent context</a></p>
          <p style="margin-top:8px">Built with Astro. © {new Date().getFullYear()} {c.name}</p>
        </footer>
      </main>
    </div>

    <!-- ============ PROJECT MODAL ============ -->
    <dialog class="modal" id="modal" aria-labelledby="m-title">
      <div class="modal-inner">
        <div class="modal-head">
          <h2 id="m-title"></h2>
          <button class="modal-close" id="m-close" aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="gallery"><div class="main" id="m-main"></div><div class="thumbs" id="m-thumbs"></div></div>
        <div class="modal-desc" id="m-desc"></div>
        <div class="modal-foot">
          <div class="chips" id="m-tools" style="margin:0"></div>
          <a class="btn" id="m-link" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
            View on GitHub
          </a>
        </div>
      </div>
    </dialog>

    <script is:inline define:vars={{ works }}>
      const root = document.documentElement;

      // ---- Day / night ----
      document.querySelectorAll("[data-theme-toggle]").forEach((b) =>
        b.addEventListener("click", () => {
          const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        })
      );

      // ---- Cursor spotlight ----
      window.addEventListener("pointermove", (e) => {
        root.style.setProperty("--mx", e.clientX + "px");
        root.style.setProperty("--my", e.clientY + "px");
      }, { passive: true });

      // ---- Active nav item ----
      const links = document.querySelectorAll("[data-nav]");
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) links.forEach((l) => l.classList.toggle("active", l.dataset.nav === en.target.id));
        });
      }, { rootMargin: "-40% 0px -55% 0px" });
      document.querySelectorAll("main section[id]").forEach((s) => io.observe(s));

      // ---- Filter ----
      const pills = document.querySelectorAll(".pill");
      const cards = document.querySelectorAll(".card");
      pills.forEach((p) => p.addEventListener("click", () => {
        pills.forEach((x) => x.classList.toggle("active", x === p));
        const f = p.dataset.filter;
        cards.forEach((c) => { c.hidden = !(f === "all" || c.dataset.cats.split(",").includes(f)); });
      }));

      // ---- Modal ----
      const toEmbed = (input) => {
        try {
          const u = new URL(input);
          const host = u.hostname.replace(/^www\./, "");
          if (u.pathname.startsWith("/embed/")) return input;
          if (host === "youtu.be") return "https://www.youtube.com/embed/" + u.pathname.slice(1);
          if (host.endsWith("youtube.com")) {
            if (u.searchParams.get("v")) return "https://www.youtube.com/embed/" + u.searchParams.get("v");
            const parts = u.pathname.split("/").filter(Boolean);
            if (parts[1]) return "https://www.youtube.com/embed/" + parts[1];
          }
        } catch (e) {}
        return input;
      };
      const modal = document.getElementById("modal");
      const main = document.getElementById("m-main");
      const thumbs = document.getElementById("m-thumbs");
      const show = (item) => {
        main.innerHTML = "";
        if (item.type === "video") {
          const f = document.createElement("iframe");
          f.src = toEmbed(item.src);
          f.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
          f.allowFullscreen = true;
          main.appendChild(f);
        } else {
          const im = document.createElement("img");
          im.src = item.src; im.alt = "";
          main.appendChild(im);
        }
      };
      cards.forEach((card) => card.addEventListener("click", () => {
        const w = works[+card.dataset.i];
        document.getElementById("m-title").textContent = w.title;
        const desc = document.getElementById("m-desc");
        desc.innerHTML = "";
        // Short lines without ending punctuation become small headings.
        (w.description || w.summary || "").split("\n").forEach((line) => {
          const t = line.trim();
          const isHead = t && t.length <= 48 && !/[.,;!?]$/.test(t) && !/^[•\-]/.test(t);
          const el = document.createElement(isHead ? "h4" : "div");
          el.textContent = isHead ? t.replace(/:$/, "") : line;
          if (!isHead && !t) el.innerHTML = "&nbsp;";
          desc.appendChild(el);
        });
        const tools = document.getElementById("m-tools");
        tools.innerHTML = "";
        (w.tools || w.tags || []).forEach((t) => {
          const s = document.createElement("span"); s.className = "chip"; s.textContent = t; tools.appendChild(s);
        });
        const link = document.getElementById("m-link");
        link.style.display = w.link ? "" : "none";
        if (w.link) link.href = w.link;

        const media = [];
        if (w.video) media.push({ type: "video", src: w.video });
        (w.images && w.images.length ? w.images : [w.thumbnail]).forEach((src) => src && media.push({ type: "img", src }));
        thumbs.innerHTML = "";
        media.forEach((m, i) => {
          const b = document.createElement("button");
          if (m.type === "video") { b.className = "vid mono"; b.textContent = "▶ VIDEO"; }
          else { const im = document.createElement("img"); im.src = m.src; im.alt = ""; b.appendChild(im); }
          b.addEventListener("click", () => {
            thumbs.querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b));
            show(m);
          });
          thumbs.appendChild(b);
        });
        thumbs.style.display = media.length > 1 ? "" : "none";
        if (media[0]) { show(media[0]); thumbs.firstChild && thumbs.firstChild.classList.add("on"); }
        modal.showModal();
        modal.querySelector(".modal-inner").scrollTop = 0;
      }));
      const close = () => { modal.close(); main.innerHTML = ""; };
      document.getElementById("m-close").addEventListener("click", close);
      modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
      modal.addEventListener("close", () => { main.innerHTML = ""; });

      // ---- Copy agent prompt ----
      const copyBtn = document.getElementById("copy-prompt");
      copyBtn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(document.getElementById("agent-prompt").innerText);
          copyBtn.textContent = "Copied ✓";
        } catch (e) { copyBtn.textContent = "Select & copy manually"; }
        setTimeout(() => (copyBtn.textContent = "Copy prompt"), 2000);
      });
    </script>
  </body>
</html>
