---
import { siteConfig } from "../config";
const accent = siteConfig.accentColor;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Power BI Custom Visuals from AppSource — browse, search and filter 1000+ custom visuals." />
    <title>PBI Custom Viz Chckr — {siteConfig.name}</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: "Segoe UI", SegoeUI, "Helvetica Neue", Arial, sans-serif;
        background: #f9fafb;
        color: #1f2937;
        min-height: 100vh;
        overflow-x: hidden;
      }
      @media (max-width: 768px) {
        #desktop-nav { display: none !important; }
        #cv-menu-toggle { display: block !important; }
      }

      .hero-bg {
        position: relative;
        overflow: hidden;
        background: white;
      }
      .hero-bg::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 800px 600px at 0% 0%, var(--accent-40) 0%, var(--accent-25) 20%, var(--accent-10) 40%, rgba(255,255,255,0.3) 70%, rgba(255,255,255,0.8) 90%, white 100%);
        z-index: 0;
      }
      .grid-pattern {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(200,200,200,0.3) 1px, transparent 1px),
          linear-gradient(90deg, rgba(200,200,200,0.3) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(ellipse at top right, white 0%, transparent 70%);
        z-index: 0;
      }
      .hero-content { position: relative; z-index: 1; }

      /* Toolbar */
      .toolbar {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem 1.5rem 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
      }

      .search-box {
        flex: 1;
        min-width: 200px;
        position: relative;
      }
      .search-box input {
        width: 100%;
        padding: 0.55rem 0.9rem 0.55rem 2.5rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 9999px;
        font-size: 0.9rem;
        font-family: inherit;
        background: white;
        outline: none;
        transition: border-color 0.15s;
      }
      .search-box input:focus { border-color: var(--accent); }
      .search-box svg {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        pointer-events: none;
      }

      .filter-group {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }
      .filter-btn {
        -webkit-appearance: none;
        appearance: none;
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        border: 1.5px solid #e5e7eb;
        background: white;
        color: #6b7280;
        transition: all 0.15s;
        white-space: nowrap;
      }
      .filter-btn:hover { border-color: #9ca3af; color: #111827; }
      .filter-btn.active { background: #1a3a5c; border-color: #1a3a5c; color: white; }

      .count-badge {
        font-size: 0.8rem;
        color: #9ca3af;
        white-space: nowrap;
        align-self: center;
        margin-left: auto;
      }

      /* Grid */
      .visuals-grid {
        max-width: 1200px;
        margin: 1.5rem auto 4rem;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
      }

      /* Thumbnail */
      .card-thumb {
        width: 100%;
        height: 130px;
        border-radius: 0.625rem;
        overflow: hidden;
        background: #f3f4f6;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .card-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: opacity 0.2s;
      }

      /* Card */
      .visual-card {
        background: white;
        border: 1px solid #f0f0f0;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: box-shadow 0.2s, transform 0.2s;
        position: relative;
      }
      .visual-card:hover {
        box-shadow: 0 6px 20px rgba(0,0,0,0.09);
        transform: translateY(-2px);
      }

      .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
      }
      .card-name {
        font-size: 0.9rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.3;
        flex: 1;
      }
      .cert-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 9999px;
        background: #ecfdf5;
        color: #059669;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .publisher {
        font-size: 0.75rem;
        color: #9ca3af;
        font-weight: 500;
      }
      .description {
        font-size: 0.8rem;
        color: #6b7280;
        line-height: 1.55;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: 0.25rem;
        padding-top: 0.75rem;
        border-top: 1px solid #f3f4f6;
      }
      .version-tag {
        font-size: 0.7rem;
        color: #9ca3af;
        font-family: monospace;
      }
      .appsource-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--accent);
        transition: opacity 0.15s;
      }
      .appsource-link:hover { opacity: 0.75; }

      /* Empty / Loading */
      #loading-state, #empty-state {
        max-width: 1200px;
        margin: 3rem auto;
        padding: 0 1.5rem;
        text-align: center;
        color: #9ca3af;
        font-size: 1rem;
      }
      .spinner {
        width: 2rem;
        height: 2rem;
        border: 3px solid #e5e7eb;
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1rem;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body style={`overflow-x: hidden; --accent: ${accent}; --accent-40: ${accent}66; --accent-25: ${accent}40; --accent-10: ${accent}1a;`}>

    <!-- Header -->
    <header style="position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.92); backdrop-filter: blur(8px); border-bottom: 1px solid #f3f4f6;">
      <nav style="max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: center;">
        <ul id="desktop-nav" style="display: flex; align-items: center; gap: 2rem; list-style: none;">
          <li><a href="/work/" style="color: #374151; text-decoration: none; font-weight: 500;">Home</a></li>
          <li><a href="/visuals/" style="color: #374151; text-decoration: none; font-weight: 500;">PBI Viz Chckr</a></li>
          <li><a href="/customvisuals/" style={`color: ${accent}; text-decoration: none; font-weight: 700;`} id="nav-current">PBI Custom Viz Chckr</a></li>
          <li><a href="/about/" style="color: #374151; text-decoration: none; font-weight: 500;">About</a></li>
          <li><a href="/about/#projects" style="color: #374151; text-decoration: none; font-weight: 500;">Projects</a></li>
          <li><a href="/about/#experience" style="color: #374151; text-decoration: none; font-weight: 500;">Experience</a></li>
          <li><a href="/about/#education" style="color: #374151; text-decoration: none; font-weight: 500;">Education</a></li>
        </ul>
        <button id="cv-menu-toggle" style="display: none; margin-left: auto; padding: 0.5rem; background: none; border: none; cursor: pointer; color: #374151;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </nav>
      <div id="cv-mobile-menu" style="display: none; background: rgba(255,255,255,0.97); border-top: 1px solid #f3f4f6; padding: 0.5rem 1.5rem 1rem;">
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.25rem;">
          <li><a href="/work/" style="display: block; padding: 0.5rem 0; color: #374151; text-decoration: none; font-weight: 500;">Home</a></li>
          <li><a href="/visuals/" style="display: block; padding: 0.5rem 0; color: #374151; text-decoration: none; font-weight: 500;">PBI Viz Chckr</a></li>
          <li><a href="/customvisuals/" style={`display: block; padding: 0.5rem 0; color: ${accent}; text-decoration: none; font-weight: 700;`}>PBI Custom Viz Chckr</a></li>
          <li><a href="/about/" style="display: block; padding: 0.5rem 0; color: #374151; text-decoration: none; font-weight: 500;">About</a></li>
          <li><a href="/about/#projects" style="display: block; padding: 0.5rem 0; color: #374151; text-decoration: none; font-weight: 500;">Projects</a></li>
          <li><a href="/about/#experience" style="display: block; padding: 0.5rem 0; color: #374151; text-decoration: none; font-weight: 500;">Experience</a></li>
          <li><a href="/about/#education" style="display: block; padding: 0.5rem 0; color: #374151; text-decoration: none; font-weight: 500;">Education</a></li>
        </ul>
      </div>
    </header>

    <!-- Hero -->
    <div class="hero-bg" style={`padding: 3.5rem 1.5rem 2.5rem;`}>
      <div class="grid-pattern"></div>
      <div class="hero-content" style="max-width: 1200px; margin: 0 auto;">
        <p style={`font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: ${accent}; margin-bottom: 0.6rem;`}>Power BI AppSource</p>
        <h1 style="font-size: clamp(2rem, 5vw, 3.75rem); font-weight: 800; color: #111827; line-height: 1.1; margin-bottom: 1rem;">
          Custom <span style={`color: ${accent}`}>Viz Chckr</span>
        </h1>
        <p style="font-size: 1.05rem; color: #6b7280; max-width: 560px; line-height: 1.7;">
          Browse all Power BI custom visuals from Microsoft AppSource. Search by name, publisher or description and filter by certified status.
        </p>
        <p style="font-size: 0.78rem; color: #9ca3af; margin-top: 0.75rem;">
          Data sourced daily from <a href="https://github.com/DataChant/PowerBI-Visuals-AppSource" target="_blank" rel="noopener noreferrer" style={`color: ${accent}; text-decoration: none;`}>DataChant/PowerBI-Visuals-AppSource</a>
        </p>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" id="searchInput" placeholder="Search by name, publisher or description…" autocomplete="off" />
      </div>
      <div class="filter-group">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="certified">Certified only</button>
        <button class="filter-btn" data-filter="uncertified">Not certified</button>
      </div>
      <span class="count-badge" id="countBadge">Loading…</span>
    </div>

    <!-- Grid -->
    <div id="loading-state">
      <div class="spinner"></div>
      Loading visuals…
    </div>
    <div class="visuals-grid" id="visualsGrid" style="display: none;"></div>
    <div id="empty-state" style="display: none;">No visuals match your search.</div>

    <script is:inline define:vars={{ accent }}>
      // Mobile menu
      const menuToggle = document.getElementById('cv-menu-toggle');
      const mobileMenu = document.getElementById('cv-mobile-menu');
      menuToggle?.addEventListener('click', () => {
        mobileMenu.style.display = mobileMenu.style.display === 'none' ? 'block' : 'none';
      });
      mobileMenu?.querySelectorAll('a').forEach(l => l.addEventListener('click', () => { mobileMenu.style.display = 'none'; }));

      // State
      let allVisuals = [];
      let currentFilter = 'all';
      let currentSearch = '';

      // Simple CSV parser that handles quoted fields
      function parseCSV(text) {
        const rows = [];
        const lines = text.split('\n');
        for (let i = 1; i < lines.length; i++) {
          const line = lines[i].trim();
          if (!line) continue;
          const fields = [];
          let field = '';
          let inQuotes = false;
          for (let j = 0; j < line.length; j++) {
            const ch = line[j];
            if (ch === '"') {
              if (inQuotes && line[j + 1] === '"') {
                field += '"';
                j++;
              } else {
                inQuotes = !inQuotes;
              }
            } else if (ch === ',' && !inQuotes) {
              fields.push(field);
              field = '';
            } else {
              field += ch;
            }
          }
          fields.push(field);
          if (fields.length >= 10) {
            rows.push({
              name: fields[0]?.trim() || '',
              publisher: fields[1]?.trim() || '',
              description: fields[2]?.trim() || '',
              version: fields[3]?.trim() || '',
              releaseDate: fields[7]?.trim() || '',
              appSourceLink: fields[8]?.trim() || '',
              isCertified: fields[9]?.trim() === 'Certified',
            });
          }
        }
        return rows;
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderGrid() {
        const search = currentSearch.toLowerCase();
        const filtered = allVisuals.filter(v => {
          const matchSearch = !search ||
            v.name.toLowerCase().includes(search) ||
            v.publisher.toLowerCase().includes(search) ||
            v.description.toLowerCase().includes(search);
          const matchFilter =
            currentFilter === 'all' ||
            (currentFilter === 'certified' && v.isCertified) ||
            (currentFilter === 'uncertified' && !v.isCertified);
          return matchSearch && matchFilter;
        });

        document.getElementById('countBadge').textContent = `${filtered.length.toLocaleString()} visual${filtered.length !== 1 ? 's' : ''}`;
        document.getElementById('empty-state').style.display = filtered.length === 0 ? 'block' : 'none';

        const grid = document.getElementById('visualsGrid');
        grid.innerHTML = filtered.map(v => {
          const imgUrl = `https://raw.githubusercontent.com/DataChant/PowerBI-Visuals-AppSource/main/All%20Visuals/Images/${encodeURIComponent(v.name)}.png`;
          return `
          <div class="visual-card">
            <div class="card-thumb">
              <img data-src="${imgUrl}" alt="" style="opacity:0;" onerror="this.remove();" />
            </div>
            <div class="card-header">
              <span class="card-name">${escapeHtml(v.name)}</span>
              ${v.isCertified ? `<span class="cert-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                Certified
              </span>` : ''}
            </div>
            <div class="publisher">${escapeHtml(v.publisher)}</div>
            <div class="description">${escapeHtml(v.description)}</div>
            <div class="card-footer">
              <span class="version-tag">v${escapeHtml(v.version)}</span>
              ${v.appSourceLink ? `<a class="appsource-link" href="${escapeHtml(v.appSourceLink)}" target="_blank" rel="noopener noreferrer" style="color: ${accent};">
                AppSource
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>` : ''}
            </div>
          </div>
        `}).join('');

        // Lazy load images with IntersectionObserver
        const imgs = grid.querySelectorAll('img[data-src]');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              img.src = img.dataset.src;
              img.onload = () => { img.style.opacity = '1'; };
              observer.unobserve(img);
            }
          });
        }, { rootMargin: '200px' });
        imgs.forEach(img => observer.observe(img));
      }

      async function loadData() {
        try {
          const res = await fetch(
            'https://raw.githubusercontent.com/DataChant/PowerBI-Visuals-AppSource/main/Visuals%20Summary.csv'
          );
          if (!res.ok) throw new Error('Failed to fetch');
          const text = await res.text();
          allVisuals = parseCSV(text);
          document.getElementById('loading-state').style.display = 'none';
          document.getElementById('visualsGrid').style.display = 'grid';
          renderGrid();
        } catch (e) {
          document.getElementById('loading-state').innerHTML = 'Failed to load visual data. Please try again later.';
        }
      }

      // Filter buttons
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentFilter = btn.getAttribute('data-filter');
          renderGrid();
        });
      });

      // Search
      let searchTimeout;
      document.getElementById('searchInput').addEventListener('input', e => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          currentSearch = e.target.value;
          renderGrid();
        }, 200);
      });

      loadData();
    </script>
  </body>
</html>
