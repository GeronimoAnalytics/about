---
import { siteConfig } from "../config";
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-accent={siteConfig.accentColor}
>
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Desktop menu -->
    <ul id="desktop-nav" class="hidden md:flex items-center gap-8 mx-auto">
      <li>
        <a
          href="/#hero"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          Home
        </a>
      </li>
      <li>
        <a
          href="/#featured-work"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          Featured work
        </a>
      </li>
      <li>
        <a
          href="/#services"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          What i do
        </a>
      </li>
      <li>
        <a
          href="/#about"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          About
        </a>
      </li>
      <li>
        <a
          href="/#contact"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          Contact
        </a>
      </li>
      <li>
        <a
          href="/work/"
          class="text-gray-700 hover:text-black transition-colors font-medium"
        >
          Portfolio
        </a>
      </li>
    </ul>

    <!-- Mobile hamburger -->
    <button id="menu-toggle" class="md:hidden ml-auto p-2 text-gray-700" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md border-t border-gray-100 px-6 pb-4">
    <ul class="flex flex-col gap-3 pt-2">
      <li><a href="/#hero" class="block py-2 text-gray-700 font-medium">Home</a></li>
      <li><a href="/#featured-work" class="block py-2 text-gray-700 font-medium">Featured work</a></li>
      <li><a href="/#services" class="block py-2 text-gray-700 font-medium">What i do</a></li>
      <li><a href="/#about" class="block py-2 text-gray-700 font-medium">About</a></li>
      <li><a href="/#contact" class="block py-2 text-gray-700 font-medium">Contact</a></li>
      <li><a href="/work/" class="block py-2 text-gray-700 font-medium">Portfolio</a></li>
    </ul>
  </div>
</header>

<script>
  // Active nav link
  const accentColor = document.getElementById('header').dataset.accent || '#06B6D4';
  const path = window.location.pathname.replace(/\/$/, '') || '/';
  document.querySelectorAll('#desktop-nav a, #mobile-menu a').forEach(a => {
    const href = a.getAttribute('href')?.split('#')[0].replace(/\/$/, '') || '';
    if (href && path === href) {
      a.style.color = accentColor;
      a.style.fontWeight = '700';
    }
  });

  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });

  // Mobile menu toggle
  const toggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
  // Close menu on link click
  mobileMenu?.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
    });
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
